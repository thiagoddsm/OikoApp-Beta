
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Rule for member notes - Allow signed-in users to read/write individual documents
    // and list/query the collection.
    match /member_notes/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Liberal rules for development:
    // Allow any signed-in user to read and write to any document.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
