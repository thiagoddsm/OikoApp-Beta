
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra Global: Permite leitura e escrita para qualquer usuário autenticado
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Permite leitura de usuários para a API Route (que roda sem auth no contexto do client SDK no servidor)
    // Essencial para o envio de notificações em massa
    match /users/{userId} {
      allow read: if true;
    }

    // Regras Específicas para Notificações (Permitem gravação via API Route e leitura via Dashboard)
    // Nota: 'allow read, write: if true' é usado aqui para permitir que a API Route (servidor) 
    // grave o histórico, já que o SDK cliente no servidor não carrega o token do usuário do browser.
    match /notifications_chats/{docId} {
      allow read, write: if true;
    }
    match /notifications_messages/{docId} {
      allow read, write: if true;
    }
    match /notifications_history/{docId} {
      allow read, write: if true;
    }
    match /notifications_responses/{docId} {
      allow read, write: if true;
    }
    
    // Regras para finanças e transações
    match /finance_requests/{docId} {
      allow read, write: if request.auth != null;
    }
    match /financial_transactions/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // Regras para configurações do sistema
    match /config/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
