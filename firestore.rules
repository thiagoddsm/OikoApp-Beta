
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Returns true if the user has the 'admin' role.
    function isAdmin() {
      // Check for either 'admin' or 'pastor_senior' in the user's role list.
      // Assumes user data is stored in /users/{userId}
      let userRoles = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hierarchy.role;
      return isSignedIn() && (userRoles == 'admin' || userRoles == 'pastor_senior');
    }

    // Publicly readable collections
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isSignedIn(); // Or more specific admin rules
    }

    // Default authenticated access for most collections
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
