
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Master admin UID
    function isMasterAdmin() {
      return request.auth.uid == '9Sm2pIH1zIOj9k8D8EcLS3bkKad2';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function getUserPermissions(userId) {
        return get(/databases/$(database)/documents/user_permissions/$(userId)).data;
    }
    
    function hasRole(role) {
        return isSignedIn() && (isMasterAdmin() || getUserData(request.auth.uid).roles.hasAny([role, 'admin', 'pastor']));
    }

    function hasPermission(permission) {
        return isSignedIn() && (isMasterAdmin() || getUserPermissions(request.auth.uid)[permission] == true);
    }
    
    function isMemberSupervisor(memberId) {
        let memberData = getUserData(memberId);
        return memberData.hierarchy.supervisorId == request.auth.uid;
    }

    // --- Collection Rules ---

    // USER: Public read, owner write. Admins can manage permissions.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || hasRole('admin');
      // Only admins can delete users.
      allow delete: if hasRole('admin');
    }

    match /user_permissions/{userId} {
        allow read: if isSignedIn();
        allow write: if hasRole('admin'); // Only admins can change permissions
    }

    // GROUPS (GCs): Authenticated read, leader/admin write.
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create, update: if hasRole('gc_leader');
      allow delete: if hasRole('admin');
    }

    // REPORTS: Leader/admin only.
    match /reports/{reportId} {
      allow read, write: if hasRole('gc_leader');
    }
    
    // --- VOLUNTEERING MODULE ---
    match /teams/{teamId} {
        allow read: if isSignedIn();
        allow write: if hasPermission('canManageTeams');
    }

    match /areas_of_service/{areaId} {
        allow read: if isSignedIn();
        allow write: if hasPermission('canManageTeams');
    }
    
    match /volunteering_events/{eventId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if hasPermission('canManageSchedules');
    }

    match /rosters/{rosterId} {
        allow read: if isSignedIn();
        // A user can update their own status (accept/decline)
        allow update: if hasPermission('canManageSchedules') || request.auth.uid == request.resource.data.positions[0].assignedTo;
        allow create: if hasPermission('canManageSchedules');
        allow delete: if hasPermission('canManageSchedules');
    }

    match /team_schedules/{scheduleId} {
        allow read: if isSignedIn();
        allow write: if hasPermission('canManageSchedules');
    }

    match /saved_schedules/{scheduleId} {
        allow read: if isSignedIn();
        allow write: if hasPermission('canManageSchedules');
    }


    // CULTOS & EVENTOS: Authenticated read, admin write.
    match /cultos/{cultoId} {
      allow read: if isSignedIn();
      allow write: if hasRole('admin');
      
      match /louvores/{louvorId} {
        allow read: if isSignedIn();
        allow write: if hasRole('admin');
      }
      match /liturgias/{liturgiaId} {
        allow read: if isSignedIn();
        allow write: if hasRole('admin');
      }
    }
    
    match /eventos/{eventoId} {
      allow read: if isSignedIn();
      allow write: if hasRole('admin');

      match /programacoes/{programacaoId} {
        allow read: if isSignedIn();
        allow write: if hasRole('admin');
      }
      match /convidados/{convidadoId} {
        allow read: if isSignedIn();
        allow write: if hasRole('admin');
      }
    }

    // BUDGET REQUESTS: Requester can create/read, admin can read/update.
    match /budget_requests/{reqId} {
        allow read: if isOwner(resource.data.requesterId) || hasRole('admin');
        allow create: if isOwner(request.resource.data.requesterId);
        allow update: if hasRole('admin'); // Only admin can approve/reject
        allow delete: if hasRole('admin');
    }
    
    // SOCIAL: Admin/pastor only.
    match /beneficiaries/{beneId} {
        allow read, write: if hasRole('pastor');
    }
    
    match /social_actions/{actionId} {
        allow read, write: if hasRole('pastor');
    }

    // GOALS: Admin/pastor read, Admin write.
    match /goals/{goalId} {
        allow read: if hasRole('pastor');
        allow write: if hasRole('admin');
    }
    
    // PATRIMONIO: Authenticated read, Admin write.
    match /patrimonio/{patrimonioId} {
        allow read: if isSignedIn();
        allow write: if hasRole('admin');
    }
    
    // ATTENDANCE: Owner can do everything.
    match /cultos/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
    
    match /attendance_reports/{reportId} {
        allow read, write: if hasRole('gc_leader');
    }
    
    match /member_notes/{noteId} {
        // Allow creating a note for any member.
        allow create: if isSignedIn();
        // Allow read of collection for queries, client-side filters will show relevant notes.
        allow read: if isSignedIn();
        // Allow updating or deleting a note if you are the author OR the supervisor of the member the note is about.
        allow update, delete: if isOwner(resource.data.authorId) || isMemberSupervisor(resource.data.memberId);
    }
    
    match /cells/{cellId} {
        allow read: if isSignedIn();
        allow create, update: if hasRole('gc_leader') || hasRole('admin');
        allow delete: if hasRole('admin');
    }
    
    // HIERARCHY: Authenticated read, leader/admin write.
    match /redes/{redeId} {
        allow read: if isSignedIn();
        allow create, update: if hasRole('lider_rede') || hasRole('admin');
        allow delete: if hasRole('admin');
    }

    match /areas/{areaId} {
        allow read: if isSignedIn();
        allow create, update: if hasRole('lider_area') || hasRole('admin');
        allow delete: if hasRole('admin');
    }

    // TEACHING: Authenticated read, Admin write.
    match /ministries/{ministryId} {
        allow read: if isSignedIn();
        allow write: if hasRole('admin');
    }

    match /courses/{courseId} {
        allow read: if isSignedIn();
        allow write: if hasRole('admin');

        match /classes/{classId} {
            allow read: if isSignedIn();
            allow write: if hasRole('admin');
        }
    }

    // ROOM RESERVATIONS: User can create/read their own, admin can manage all.
    match /room_reservations/{reservationId} {
        allow read: if isSignedIn();
        allow create: if isOwner(request.resource.data.requesterId);
        allow update: if hasRole('admin');
        allow delete: if isOwner(resource.data.requesterId) || hasRole('admin');
    }
  }
}
