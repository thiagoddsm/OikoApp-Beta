
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras Públicas: Catálogo de Ensino
    match /courses/{courseId} {
      allow read: if true;
    }
    match /classes/{classId} {
      allow read: if true;
    }
    
    // Regras Públicas: Protocolos de Inscrição
    match /enrollment_requests/{requestId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // Regras Públicas: Solicitações Financeiras
    match /finance_requests/{reqId} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    // Regras de Identificação: Permite busca por e-mail no portal público
    match /users/{userId} {
      allow read: if true; 
      allow write: if request.auth != null;
    }
    
    // Regras Gerais
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
