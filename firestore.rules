
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Master admin UID for thiagoddsm@gmail.com
    function isMasterAdmin() {
      return request.auth.uid == '9Sm2pIH1zIOj9k8D8EcLS3bkKad2';
    }

    // --- Liberal Rules for Development ---
    // Allow any signed-in user to read and write to any document.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
