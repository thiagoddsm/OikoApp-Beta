
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Returns true if the user has the 'admin' role.
    function isAdmin() {
      // Check for either 'admin' or 'pastor_senior' in the user's role list.
      // Assumes user data is stored in /users/{userId}
      let userRoles = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hierarchy.role;
      return isSignedIn() && (userRoles == 'admin' || userRoles == 'pastor_senior');
    }

    // --- Publicly readable collection ---
    // This rule allows anyone, even unauthenticated users, to read the list of rooms.
    // This is necessary for the public event planning form.
    // Write access is still restricted to signed-in users.
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // --- All other collections ---
    // Default to requiring authentication for all other read/write operations.
    // This rule does NOT apply to /rooms/{roomId} because a more specific rule already matches it.
    match /{path=**}/documents/{document} {
      allow read, write: if isSignedIn() && path != ["rooms"];
    }
  }
}
