
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Explicit rule for member_notes to allow read/write for any authenticated user
    match /member_notes/{noteId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false; // For now, prevent updates/deletes
    }

    // Liberal rules for development for all other collections
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
