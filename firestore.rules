
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // REGRAS 100% LIBERAIS PARA FASE DE TESTES
    // Permite que qualquer pessoa (mesmo sem login) leia e escreva em qualquer documento.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
