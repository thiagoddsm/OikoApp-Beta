
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras Públicas: Catálogo de Ensino
    // Permite que qualquer pessoa veja os cursos e turmas disponíveis
    match /courses/{courseId} {
      allow read: if true;
    }
    match /classes/{classId} {
      allow read: if true;
    }
    
    // Regras Públicas: Protocolos de Inscrição
    // Permite que visitantes enviem solicitações, mas não leiam as de outros
    match /enrollment_requests/{requestId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // Regras Públicas: Solicitações Financeiras
    match /finance_requests/{reqId} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    // Regras Protegidas: Usuários e Perfis
    // A verificação de e-mail agora é feita via Server Action (actions.ts)
    // mantendo a coleção protegida contra acessos anônimos diretos
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Regras Gerais para usuários autenticados
    match /pedagogical_logs/{logId} { allow read, write: if request.auth != null; }
    match /financial_transactions/{txId} { allow read, write: if request.auth != null; }
    match /saved_schedules/{scheduleId} { allow read, write: if request.auth != null; }
    match /theoflix_courses/{docId} { allow read: if request.auth != null; }
    match /rooms/{docId} { allow read: if request.auth != null; }

    // Fallback padrão
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
