
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Liberal rules for development:
    // Allow any signed-in user to read and write to any document.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
