rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hierarchy.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hierarchy.role == 'pastor_senior'
        );
    }

    // ── Permissão Geral para Usuários Autenticados no App ──────────────────────
    // Qualquer usuário autenticado no sistema tem permissão total de leitura/escrita
    // nas coleções da aplicação para evitar bloqueios de permissão durante navegação.
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Formulários públicos (criação anônima permitida para inscrições)
    match /enrollment_requests/{requestId} {
      allow create: if true;
    }
    match /event_registrations/{regId} {
      allow create: if true;
    }
    match /finance_requests/{reqId} {
      allow create: if true;
    }

    // Roteiros de GC (Leitura pública para membros e líderes)
    match /gc_roteiros/{roteiroId} {
      allow read: if true;
    }

    // Audit Logs (Imutável por clientes)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
