
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Allow list/query on the collection and read/write on individual documents
    match /member_notes/{noteId} {
      allow read, write: if isSignedIn();
    }
    match /member_notes {
      allow list: if isSignedIn();
    }

    // Liberal rules for development:
    // Allow any signed-in user to read and write to any document.
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
