rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ATENÇÃO: Regra de teste super liberal. Permite acesso total a qualquer pessoa.
    // NÃO USAR EM PRODUÇÃO. Apenas para diagnosticar o problema de permissão.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}