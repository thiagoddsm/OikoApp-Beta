rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hierarchy.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hierarchy.role == 'pastor_senior'
        );
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /theoflix_courses/{courseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /theoflix_levels/{levelId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // CORREÇÃO CRÍTICA 1: Bloquear elevação de privilégio (Self-Elevation)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      // Se for o dono do perfil, permite update APENAS SE não estiver alterando a própria hierarquia ou roles
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['hierarchy', 'roles', 'isTeacher', 'globalRoles'])))
      );
      allow delete: if isAdmin();
    }

    match /users/{userId}/notes/{noteId} {
      allow read, write: if isAuthenticated();
    }

    match /enrollment_requests/{requestId} {
      allow create: if true;
      allow read, write: if isAuthenticated();
    }

    match /wave_payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    match /dis_payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
      allow list: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    match /pedagogical_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /finance_requests/{reqId} {
      allow create: if true;
      allow read, write: if isAuthenticated();
    }

    match /financial_transactions/{txId} {
      allow read, write: if isAdmin();
    }

    match /access_profiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /config/theoflix {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /notification_campaigns/{campaignId} {
      allow read, write: if isAuthenticated();
    }

    // Células, Áreas e Redes (GC)
    match /cells/{cellId} {
      allow read, write: if isAuthenticated();
    }
    match /areas/{areaId} {
      allow read, write: if isAuthenticated();
    }
    match /redes/{redeId} {
      allow read, write: if isAuthenticated();
    }
    match /reuniao_logs/{logId} {
      allow read, write: if isAuthenticated();
    }
    match /presencas_historico/{presencaId} {
      allow read, write: if isAuthenticated();
    }

    // CORREÇÃO CRÍTICA 2: Mapeamento Explícito das Coleções Órfãs (Substitui o Fallback Global)
    match /system_settings/{document=**} {
      allow read, write: if isAdmin(); // Protege o token do Asaas Webhook
    }
    match /asaasPayments/{document=**} {
      allow read, write: if isAdmin();
    }
    match /asaasSubscriptions/{document=**} {
      allow read, write: if isAdmin();
    }
    match /asaasAnticipations/{document=**} {
      allow read, write: if isAdmin();
    }

    // Eventos e Voluntariado
    match /event_registrations/{document=**} { allow read, write: if isAuthenticated(); }
    match /volunteering_events/{document=**} { allow read, write: if isAuthenticated(); }
    match /teams/{document=**} { allow read, write: if isAuthenticated(); }
    match /areas_of_service/{document=**} { allow read, write: if isAuthenticated(); }
    match /room_reservations/{document=**} { allow read, write: if isAuthenticated(); }
    match /strategic_events/{document=**} { allow read, write: if isAuthenticated(); }
    match /reservation_categories/{document=**} { allow read, write: if isAuthenticated(); }
    match /rooms/{document=**} { allow read, write: if isAuthenticated(); }
    match /saved_schedules/{document=**} { allow read, write: if isAuthenticated(); }
    match /wave_plans/{document=**} { allow read, write: if isAuthenticated(); }
    match /dis_plans/{document=**} { allow read, write: if isAuthenticated(); }
    match /wave_expenses/{document=**} { allow read, write: if isAuthenticated(); }

    // O FALLBACK INSEGURO FOI REMOVIDO
  }
}
