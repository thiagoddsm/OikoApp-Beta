
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras Públicas: Essenciais para o Portal de Inscrições
    match /courses/{courseId} {
      allow read: if true;
    }
    match /classes/{classId} {
      allow read: if true;
    }
    match /theoflix_courses/{courseId} {
      allow read: if true;
    }
    
    // Identificação: Permite que o servidor (via Server Action) verifique a existência do e-mail
    // A leitura pública de users é limitada para evitar vazamento total, mas necessária para busca exata
    match /users/{userId} {
      allow read: if true; 
      allow write: if request.auth != null;
    }

    // Inscrições: Qualquer um pode criar um protocolo de interesse
    match /enrollment_requests/{requestId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // Financeiro: Protocolos públicos
    match /finance_requests/{reqId} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }
    
    // Regras Gerais para Admin/Liderança
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
