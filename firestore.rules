rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public rules for the enrollment portal
    match /courses/{courseId} {
      allow read: if true;
    }
    match /classes/{classId} {
      allow read: if true;
    }
    match /enrollment_requests/{requestId} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // Rules for public finance requests
    match /finance_requests/{reqId} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    // Rules for authenticated users only
    match /users/{userId} {
      // Use Server Actions for anonymous email verification
      allow read, write: if request.auth != null;
    }
    
    match /pedagogical_logs/{logId} {
      allow read, write: if request.auth != null;
    }
    
    match /financial_transactions/{txId} {
      allow read, write: if request.auth != null;
    }
    
    match /saved_schedules/{scheduleId} {
      allow read, write: if request.auth != null;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}