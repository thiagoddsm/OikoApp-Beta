
/**
 * @fileoverview Firestore Security Rules for ConectarGC application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data (culto records)
 * and employs role-based access control for administrative functions. All other collections
 * are secured based on explicit authorization. Data shape validation is relaxed for rapid prototyping.
 *
 * Data Structure:
 * - /users/{userId}: User profile information.
 * - /cells/{cellId}: Cell group details.
 * - /attendance_reports/{reportId}: Attendance reports for cell meetings.
 * - /leader_tasks/{taskId}: Tasks assigned to cell leaders.
 * - /discipleship_plans/{planId}: Discipleship plans between leaders and members.
 * - /cultos/{userId}/registros/{registroId}: Attendance records for church services (cultos), owned by individual users.
 * - /member_notes/{noteId}: Notes about members made by leaders.
 *
 * Key Security Decisions:
 * - User data and attendance records are strictly controlled by the owning user.
 * - Admin privileges are determined by the `hierarchy.role` field in the user's document.
 * - List operations are generally restricted to the owner of the data, except where public access is explicitly intended.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided userId and if the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId));
    }

    /**
     * @description Checks if the requesting user has an admin role.
     * Admin roles are 'pastor_senior' or 'admin'.
     */
    function isAdmin() {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hierarchy.role;
      return isSignedIn() && (userRole == 'pastor_senior' || userRole == 'admin');
    }
    
     /**
     * @description Checks if the requesting user has any leadership role (not a 'membro').
     */
    function isAnyLeader() {
       return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hierarchy.role != 'membro';
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     */
    match /users/{userId} {
      // Allow read only to self or to any leader/admin.
      allow get: if isAnyLeader();
      // Allow listing only for leaders/admins.
      allow list: if isAnyLeader();
      // Allow a leader to create a doc for anyone.
      allow create: if isAnyLeader();
      // Only admins can change roles. Owners can't change their own role.
      allow update: if (isOwner(userId) && request.resource.data.hierarchy.role == resource.data.hierarchy.role) || isAdmin();
      // Only admins can delete users.
      allow delete: if isAdmin();
    }

    /**
     * @description Rules for cell group data.
     * Leaders can read, admins can write.
     */
    match /cells/{cellId} {
      allow get, list: if isAnyLeader();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for area data.
     */
    match /areas/{areaId} {
      allow get, list: if isAnyLeader();
      allow create, update, delete: if isAdmin();
    }
    
    /**
     * @description Rules for rede data.
     */
    match /redes/{redeId} {
      allow get, list: if isAnyLeader();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for attendance reports.
     */
    match /attendance_reports/{reportId} {
      allow get, list: if isAnyLeader();
      allow create, update, delete: if isAnyLeader();
    }

    /**
     * @description Rules for leader tasks.
     */
    match /leader_tasks/{taskId} {
      // Allow a leader to manage their own tasks.
      allow get, list: if isOwner(get(/databases/$(database)/documents/leader_tasks/$(taskId)).data.liderId) || isAdmin();
      allow create: if isOwner(request.resource.data.liderId) || isAdmin();
      allow update, delete: if isOwner(resource.data.liderId) || isAdmin();
    }

    /**
     * @description Rules for discipleship plans.
     */
    match /discipleship_plans/{planId} {
      allow get, list: if isAnyLeader();
      allow create, update, delete: if isAnyLeader();
    }
    
    /**
     * @description Rules for attendance records for church services (cultos), owned by individual users.
     */
    match /cultos/{userId}/registros/{registroId} {
      allow get, list, create: if isOwner(userId) || isAdmin();
      allow update, delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Rules for notes on members.
     */
    match /member_notes/{noteId} {
      allow get: if isAnyLeader();
      allow list: if isAnyLeader() && request.query.get('memberId') != null;
      allow create: if isAnyLeader() && isOwner(request.resource.data.authorId);
      allow update, delete: if isAnyLeader() && isOwner(resource.data.authorId);
    }
  }
}

    