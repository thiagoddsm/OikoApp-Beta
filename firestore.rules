
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra Global: Permite leitura e escrita para qualquer usuário autenticado em qualquer documento
    // Essencial para o funcionamento do MVP e integração de notificações
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Regras explícitas para as coleções de notificações
    // Garante que operações de 'list' (consultas) funcionem corretamente
    match /notifications_chats/{docId} {
      allow read, write: if request.auth != null;
    }
    match /notifications_messages/{docId} {
      allow read, write: if request.auth != null;
    }
    match /notifications_history/{docId} {
      allow read, write: if request.auth != null;
    }
    match /notifications_responses/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // Regras para finanças e transações
    match /finance_requests/{docId} {
      allow read, write: if request.auth != null;
    }
    match /financial_transactions/{docId} {
      allow read, write: if request.auth != null;
    }
    
    // Regras para configurações do sistema
    match /config/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
