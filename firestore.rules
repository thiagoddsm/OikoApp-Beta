
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper para verificar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper para verificar se o documento pertence ao usuário logado
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Regras Públicas: Essenciais para o Portal de Inscrições e TheoFlix
    match /courses/{courseId} {
      allow read: if true;
    }
    match /classes/{classId} {
      allow read: if true;
    }
    match /theoflix_courses/{courseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Usuários: Leitura pública necessária para login/busca, escrita autenticada
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Inscrições: Qualquer um pode criar, autenticado pode ler
    match /enrollment_requests/{requestId} {
      allow create: if true;
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Pagamentos Wave: Usuário pode ler apenas os próprios, admin lê tudo
    match /wave_payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource == null
      );
      allow list: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Pagamentos DIS: Usuário pode ler apenas os próprios, admin lê tudo
    match /dis_payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource == null
      );
      allow list: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Logs Pedagógicos: Autenticado pode ler e escrever
    match /pedagogical_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Financeiro: Protocolos de requisição
    match /finance_requests/{reqId} {
      allow create: if true;
      allow read, write: if isAuthenticated();
    }

    // Regra Geral: Qualquer usuário autenticado pode ler e escrever o restante
    // (Admins e membros com permissão usam o controle de acesso da aplicação)
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
