
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Returns true if the user has the 'admin' role.
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles[0] == 'admin';
    }

    // Liberal rules for development for all other collections
    match /{document=**} {
      allow read, write: if isAdmin() || isSignedIn();
    }
  }
}
