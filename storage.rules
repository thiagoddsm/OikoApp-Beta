
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default to deny access
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Allow authenticated users to upload to diagnostic-uploads
    match /diagnostic-uploads/{fileName} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }

    // Allow authenticated users to upload to finance-attachments
    match /finance-attachments/{fileName} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }
  }
}
