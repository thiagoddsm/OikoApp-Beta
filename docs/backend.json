
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user in the system.",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "roles": {
          "type": "array",
          "items": { "type": "string", "enum": ["admin", "pastor_senior", "pastor", "lider_rede", "lider_area", "lider_gc", "team_leader", "member", "volunteer"] },
          "description": "User roles."
        },
        "familyId": { "type": "string", "description": "ID linking users of the same family." },
        "journey": {
          "type": "object",
          "description": "Tracks the user's progress in the spiritual journey.",
          "properties": {
            "td": { "type": "boolean", "description": "Trilho do Crescimento" },
            "baptism": { "type": "boolean" },
            "membership_course": { "type": "boolean" }
          }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Spiritual gifts and skills."
        },
        "stats": {
          "type": "object",
          "properties": {
            "attendance_streak": { "type": "number" },
            "last_checkin": { "type": "string", "format": "date-time" },
            "volunteer_hours": { "type": "number" }
          }
        },
        "blockedDates": {
            "type": "array",
            "items": { "type": "string", "format": "date" },
            "description": "Dates the volunteer is unavailable to serve."
        },
        "eligibleEventIds": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs of the VolunteeringEvent the user is available for."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "dataNascimento": { "type": "string", "format": "date" },
        "address": {
          "type": "object",
          "properties": { "street": { "type": "string" } }
        },
        "batizado": { "type": "string", "enum": ["sim", "nao"] },
        "igrejaBatismo": { "type": "string" },
        "membroAntigo": { "type": "string", "enum": ["sim", "nao"] },
        "igrejaAntiga": { "type": "string" },
        "decisao": { "type": "array", "items": { "type": "string", "enum": ["Decisão por Cristo", "Reconciliação", "Ingressar em um GC", "Apenas Visitando"] } },
        "initialStatus": { "type": "string", "enum": ["nao_convertido", "novo_convertido", "reconciliado", "membro_outra_igreja"], "description": "The initial status of the person when they joined."},
        "dataDecisao": { "type": "string", "format": "date" },
        "estadoCivil": { "type": "string" },
        "temFilhos": { "type": "string", "enum": ["sim", "nao"] },
        "idadeFilhos": { "type": "string" },
        "comoConheceu": { "type": "string" },
        "nomeConvidou": { "type": "string" },
        "contatoPreferencia": { "type": "array", "items": { "type": "string" } },
        "contatoTurno": { "type": "array", "items": { "type": "string" } },
        "integrationStatus": { "type": "string" },
        "serviceStatus": { "type": "string", "enum": ["serving", "not_serving"], "description": "Indicates if the user is currently serving." },
        "serviceAreaId": { "type": "string", "description": "ID of the AreaOfService the user serves in." },
        "serviceTeamId": { "type": "string", "description": "ID of the Team the user is part of." },
        "lastServedDate": { "type": "string", "format": "date-time", "description": "The last date the volunteer served." },
        "hierarchy": {
          "type": "object",
          "properties": {
            "celulaId": { "type": "string" },
            "supervisorId": { "type": "string" },
            "role": { "type": "string" }
          }
        },
        "dizimista": { "type": "string", "enum": ["sim", "nao"] }
      },
      "required": ["name", "email", "roles", "createdAt"]
    },
    "UserPermission": {
      "title": "User Permission",
      "type": "object",
      "description": "Controls what a user can do in the system.",
      "properties": {
        "canManageTeams": { "type": "boolean" },
        "canManageSchedules": { "type": "boolean" },
        "canViewAdminDashboard": { "type": "boolean" }
      }
    },
    "Group": {
      "title": "Group",
      "type": "object",
      "description": "Represents a GC (Growth Group).",
      "properties": {
        "name": { "type": "string" },
        "leaderId": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "address": {
          "type": "object",
          "properties": {
            "street": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "meetingDay": { "type": "string" },
        "multiplication_thermometer": { "type": "number", "description": "Visual indicator for multiplication readiness (0-100)." }
      },
      "required": ["name", "leaderId"]
    },
    "Report": {
      "title": "Report",
      "type": "object",
      "description": "A report from a GC meeting.",
      "properties": {
        "groupId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "present_count": { "type": "number" },
        "visitor_count": { "type": "number" },
        "offering_amount": { "type": "number" }
      },
      "required": ["groupId", "date", "present_count"]
    },
    "Team": {
        "title": "Team",
        "type": "object",
        "description": "A volunteer team (e.g., Alpha, Bravo) for rotation.",
        "properties": {
            "name": { "type": "string" },
            "members": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name"]
    },
    "AreaOfService": {
      "title": "Area of Service",
      "type": "object",
      "description": "A specific area where volunteers serve (e.g., Media, Worship, Kids).",
      "properties": {
        "name": { "type": "string" },
        "leaderId": { "type": "string", "description": "User ID of the area leader." },
        "leaderContact": { "type": "string", "description": "Contact info for the leader." }
      },
      "required": ["name"]
    },
    "VolunteeringEvent": {
      "title": "Volunteering Event",
      "type": "object",
      "description": "Defines an event that requires volunteers, forming the basis for schedules.",
      "properties": {
        "name": { "type": "string" },
        "frequency": { "type": "string", "enum": ["semanal", "pontual"] },
        "time": { "type": "string", "format": "time", "description": "e.g., 19:00" },
        "dayOfWeek": { "type": "string", "enum": ["Domingo", "Segunda-feira", "Terça-feira", "Quarta-feira", "Quinta-feira", "Sexta-feira", "Sábado"], "description": "Required if frequency is 'semanal'." },
        "date": { "type": "string", "format": "date", "description": "Required if frequency is 'pontual'." },
        "room": { "type": "string", "description": "The room/space required for the event." },
        "requiredAreas": {
          "type": "array",
          "description": "List of service areas required for this event and the number of volunteers needed.",
          "items": {
            "type": "object",
            "properties": {
              "areaId": { "type": "string" },
              "quantity": { "type": "number" }
            },
            "required": ["areaId", "quantity"]
          }
        },
        "responsibleId": { "type": "string", "description": "User ID of the event responsible." },
        "responsibleContact": { "type": "string" },
        "observations": { "type": "string" }
      },
      "required": ["name", "frequency", "time"]
    },
    "Briefing": {
      "title": "Briefing",
      "type": "object",
      "description": "Represents a complete briefing for a church service or event, used by Briefing Pro V3.",
      "properties": {
        "cultInfo": {
          "type": "object",
          "properties": {
            "titulo": { "type": "string" },
            "tema": { "type": "string" },
            "date": { "type": "string", "format": "date" },
            "startTime": { "type": "string", "format": "time" },
            "pregador": { "type": "string" },
            "dirigente": { "type": "string" },
            "local": { "type": "string" }
          }
        },
        "staff": {
          "type": "object",
          "properties": {
            "coordenador": { "type": "string" },
            "som": { "type": "string" },
            "projecao": { "type": "string" },
            "iluminacao": { "type": "string" },
            "transmissao": { "type": "string" },
            "recepcao": { "type": "string" }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "duration": { "type": "number" },
              "responsible": { "type": "string" },
              "description": { "type": "string" },
              "colors": {
                "type": "object",
                "properties": {
                  "item": { "type": "string" }
                }
              },
              "technical": {
                "type": "object",
                "properties": {
                  "lighting": { "type": "string" },
                  "sound": { "type": "string" },
                  "projection": { "type": "string" }
                }
              },
              "completed": { "type": "boolean" }
            }
          }
        },
        "obsDepartamentos": {
          "type": "object",
          "properties": {
            "midia": { "type": "string" },
            "musica": { "type": "string" },
            "staff": { "type": "string" },
            "diaconato": { "type": "string" }
          }
        },
        "liveState": {
            "type": "object",
            "properties": {
                "currentItemIndex": { "type": "number" },
                "isRunning": { "type": "boolean" },
                "itemStartTime": { "type": ["number", "null"] },
                "accumulatedTime": { "type": "number" },
                "alert": { 
                    "type": ["object", "null"],
                    "properties": {
                        "message": { "type": "string" },
                        "time": { "type": "number" }
                    }
                }
            }
        }
      }
    },
    "TeamSchedule": {
      "title": "Team Schedule",
      "type": "object",
      "description": "The rotation schedule for teams across weeks.",
      "properties": {
        "weekNumber": { "type": "number" },
        "teamId": { "type": "string" }
      },
      "required": ["weekNumber", "teamId"]
    },
    "SavedSchedule": {
      "title": "Saved Schedule",
      "type": "object",
      "description": "A generated monthly schedule for a specific area and month.",
      "properties": {
        "areaId": { "type": "string" },
        "month": { "type": "string", "description": "e.g., '2024-08'" },
        "schedule": { "type": "object", "description": "Complex object representing the full schedule."}
      },
      "required": ["areaId", "month"]
    },
    "Roster": {
        "title": "Roster",
        "type": "object",
        "description": "A schedule for a specific team and date/event.",
        "properties": {
            "teamId": { "type": "string" },
            "eventId": { "type": "string" },
            "date": { "type": "string", "format": "date" },
            "positions": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "title": { "type": "string" },
                        "assignedTo": { "type": "string", "description": "User ID" },
                        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] }
                    }
                }
            }
        },
        "required": ["teamId", "date"]
    },
    "Culto": {
        "title": "Culto",
        "type": "object",
        "description": "Briefing de um culto, com título, tema, data, pregador e equipes.",
        "properties": {
            "title": { "type": "string" },
            "theme": { "type": "string" },
            "date": { "type": "string", "format": "date-time" },
            "preacher": { "type": "string" },
            "teams": { "type": "object" }
        },
        "required": ["title", "date"]
    },
    "Louvor": {
        "title": "Louvor",
        "type": "object",
        "description": "Música de louvor dentro de um culto.",
        "properties": {
            "cultoId": { "type": "string" },
            "name": { "type": "string" },
            "key": { "type": "string" },
            "singer": { "type": "string" }
        },
        "required": ["cultoId", "name"]
    },
    "Liturgia": {
        "title": "Liturgia",
        "type": "object",
        "description": "Momento específico na ordem do culto.",
        "properties": {
            "cultoId": { "type": "string" },
            "moment_name": { "type": "string" },
            "details": { "type": "string" }
        },
        "required": ["cultoId", "moment_name"]
    },
    "Evento": {
        "title": "Evento",
        "type": "object",
        "description": "Briefing de um evento geral.",
        "properties": {
            "title": { "type": "string" },
            "theme": { "type": "string" },
            "description": { "type": "string" },
            "location": { "type": "string" }
        },
        "required": ["title"]
    },
    "StrategicEvent": {
      "title": "Strategic Event",
      "type": "object",
      "description": "Represents a detailed strategic event plan.",
      "properties": {
        "eventName": { "type": "string" },
        "ministry": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "smart": {
          "type": "object",
          "properties": {
            "specific": { "type": "string" },
            "measurable": { "type": "string" },
            "achievable": { "type": "string" },
            "relevant": { "type": "string" },
            "timeBound": { "type": "string" }
          }
        },
        "method5w2h": {
          "type": "object",
          "properties": {
            "what": { "type": "string" },
            "why": { "type": "string" },
            "who": { "type": "string" },
            "where": { "type": "string" },
            "when": { "type": "string" },
            "how": { "type": "string" },
            "howMuch": { "type": "string" }
          }
        },
        "status": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventName", "ministry", "date", "status", "submittedAt"]
    },
    "Programacao": {
        "title": "Programacao",
        "type": "object",
        "description": "Atividade agendada dentro de um evento.",
        "properties": {
            "eventoId": { "type": "string" },
            "activity_name": { "type": "string" },
            "time": { "type": "string" }
        },
        "required": ["eventoId", "activity_name"]
    },
    "Convidado": {
        "title": "Convidado",
        "type": "object",
        "description": "Palestrante ou convidado especial de um evento.",
        "properties": {
            "eventoId": { "type": "string" },
            "name": { "type": "string" },
            "role": { "type": "string" }
        },
        "required": ["eventoId", "name"]
    },
    "BudgetRequest": {
        "title": "Budget Request",
        "type": "object",
        "description": "A 5W2H budget request for an event or ministry need.",
        "properties": {
            "what": { "type": "string" },
            "why": { "type": "string" },
            "where": { "type": "string" },
            "when": { "type": "string" },
            "who": { "type": "string" },
            "how": { "type": "string" },
            "how_much": { "type": "number" },
            "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
            "requesterId": { "type": "string" }
        },
        "required": ["what", "why", "how_much", "requesterId", "status"]
    },
    "Beneficiary": {
        "title": "Beneficiary",
        "type": "object",
        "description": "A person or family receiving social assistance.",
        "properties": {
            "name": { "type": "string" },
            "socioeconomic_data": { "type": "object" }
        },
        "required": ["name"]
    },
    "SocialAction": {
        "title": "Social Action",
        "type": "object",
        "description": "A record of social assistance provided.",
        "properties": {
            "beneficiaryId": { "type": "string" },
            "date": { "type": "string", "format": "date-time" },
            "type": { "type": "string", "description": "e.g., 'food_basket', 'medicine'" },
            "description": { "type": "string" }
        },
        "required": ["beneficiaryId", "date", "type"]
    },
    "Patrimonio": {
      "title": "Patrimonio",
      "type": "object",
      "description": "Represents a physical asset of the church.",
      "properties": {
        "name": { "type": "string", "description": "Name of the asset." },
        "description": { "type": "string", "description": "Optional description." },
        "category": { "type": "string", "description": "e.g., Mobiliário, Eletrônicos, Cabos" },
        "location": { "type": "string", "description": "e.g., Depósito, Sala 1, Auditório" },
        "status": { "type": "string", "enum": ["Disponível", "Emprestado", "Manutenção"] },
        "qrCodeValue": { "type": "string", "description": "The unique value stored in the QR code, typically the document ID." },
        "purchaseDate": { "type": "string", "format": "date" },
        "purchaseValue": { "type": "number" },
        "lastCheckedOutBy": { "type": "string", "description": "User ID of the person who last checked out the item." },
        "lastCheckedOutDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "status", "qrCodeValue", "createdAt"]
    },
    "Ministry": {
      "title": "Ministry",
      "type": "object",
      "description": "Represents a teaching ministry like IBM College, Wave, or DIS.",
      "properties": {
        "name": { "type": "string", "description": "Name of the ministry (e.g., 'IBM College')." },
        "description": { "type": "string" }
      },
      "required": ["name"]
    },
    "Course": {
      "title": "Course",
      "type": "object",
      "description": "Represents a course within a ministry.",
      "properties": {
        "ministryId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["ministryId", "name"]
    },
    "Class": {
      "title": "Class",
      "type": "object",
      "description": "Represents a specific class or group for a course.",
      "properties": {
        "courseId": { "type": "string" },
        "name": { "type": "string", "description": "Name of the class (e.g., 'Turma de Sábado')." },
        "teacherId": { "type": "string" },
        "students": { "type": "array", "items": { "type": "string" } },
        "schedule": { "type": "string", "description": "e.g., 'Sábados, 10:00 - 12:00'" }
      },
      "required": ["courseId", "name"]
    },
    "Room": {
      "title": "Room",
      "type": "object",
      "description": "A reservable room or space in the church.",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "RoomReservation": {
      "title": "Room Reservation",
      "type": "object",
      "description": "A request to reserve a room or space in the church.",
      "properties": {
        "eventName": { "type": "string", "description": "Name of the event or activity." },
        "requesterId": { "type": "string", "description": "User ID of the person making the request." },
        "rooms": { "type": "array", "items": { "type": "string" }, "description": "The name(s) of the room(s) or space(s) being requested." },
        "startDateTime": { "type": "string", "format": "date-time" },
        "endDateTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "notes": { "type": "string", "description": "Additional details or notes about the reservation." },
        "createdAt": { "type": "string", "format": "date-time" },
        "frequency": { "type": "string", "enum": ["pontual", "semanal", "quinzenal", "mensal"] },
        "dayOfWeek": { "type": "string" },
        "weekOfMonth": { "type": "string", "enum": ["1", "2", "3", "4", "last"] }
      },
      "required": ["eventName", "requesterId", "rooms", "startDateTime", "endDateTime", "status", "createdAt"]
    },
    "DiscipleshipChecklist": {
      "title": "Discipleship Checklist",
      "type": "object",
      "description": "Defines the checklist questions for a specific discipleship phase.",
      "properties": {
        "phaseId": { "type": "string", "description": "The ID of the phase (e.g., 'novo_convertido')." },
        "title": { "type": "string", "description": "The display title of the phase." },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" }
            },
            "required": ["id", "label"]
          }
        }
      },
      "required": ["phaseId", "title", "questions"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "schema": { "$ref": "#/entities/User" } } },
      { "path": "/user_permissions/{userId}", "definition": { "schema": { "$ref": "#/entities/UserPermission" } } },
      { "path": "/groups/{groupId}", "definition": { "schema": { "$ref": "#/entities/Group" } } },
      { "path": "/reports/{reportId}", "definition": { "schema": { "$ref": "#/entities/Report" } } },
      { "path": "/teams/{teamId}", "definition": { "schema": { "$ref": "#/entities/Team" } } },
      { "path": "/areas_of_service/{areaId}", "definition": { "schema": { "$ref": "#/entities/AreaOfService" } } },
      { "path": "/volunteering_events/{eventId}", "definition": { "schema": { "$ref": "#/entities/VolunteeringEvent" } } },
      { "path": "/briefings/{briefingId}", "definition": { "schema": { "$ref": "#/entities/Briefing" } } },
      { "path": "/team_schedules/{scheduleId}", "definition": { "schema": { "$ref": "#/entities/TeamSchedule" } } },
      { "path": "/saved_schedules/{scheduleId}", "definition": { "schema": { "$ref": "#/entities/SavedSchedule" } } },
      { "path": "/rosters/{rosterId}", "definition": { "schema": { "$ref": "#/entities/Roster" } } },
      { "path": "/cultos/{cultoId}", "definition": { "schema": { "$ref": "#/entities/Culto" } } },
      { "path": "/cultos/{cultoId}/louvores/{louvorId}", "definition": { "schema": { "$ref": "#/entities/Louvor" } } },
      { "path": "/cultos/{cultoId}/liturgias/{liturgiaId}", "definition": { "schema": { "$ref": "#/entities/Liturgia" } } },
      { "path": "/eventos/{eventoId}", "definition": { "schema": { "$ref": "#/entities/Evento" } } },
      { "path": "/strategic_events/{eventId}", "definition": { "schema": { "$ref": "#/entities/StrategicEvent" } } },
      { "path": "/eventos/{eventoId}/programacoes/{programacaoId}", "definition": { "schema": { "$ref": "#/entities/Programacao" } } },
      { "path": "/eventos/{eventoId}/convidados/{convidadoId}", "definition": { "schema": { "$ref": "#/entities/Convidado" } } },
      { "path": "/budget_requests/{reqId}", "definition": { "schema": { "$ref": "#/entities/BudgetRequest" } } },
      { "path": "/beneficiaries/{beneId}", "definition": { "schema": { "$ref": "#/entities/Beneficiary" } } },
      { "path": "/social_actions/{actionId}", "definition": { "schema": { "$ref": "#/entities/SocialAction" } } },
      { "path": "/patrimonio/{patrimonioId}", "definition": { "schema": { "$ref": "#/entities/Patrimonio" } } },
      { "path": "/ministries/{ministryId}", "definition": { "schema": { "$ref": "#/entities/Ministry" } } },
      { "path": "/courses/{courseId}", "definition": { "schema": { "$ref": "#/entities/Course" } } },
