
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user in the system.",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "roles": {
          "type": "array",
          "items": { "type": "string", "enum": ["admin", "pastor_senior", "pastor", "lider_rede", "lider_area", "lider_gc", "team_leader", "member", "volunteer"] }
        },
        "integrationStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "createdAt"]
    },
    "NotificationChat": {
      "title": "Notification Chat",
      "type": "object",
      "description": "Summary of a conversation.",
      "properties": {
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "userName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "unreadCount": { "type": "number" },
        "isGroup": { "type": "boolean" }
      }
    },
    "NotificationMessage": {
      "title": "Notification Message",
      "type": "object",
      "description": "Individual message entry.",
      "properties": {
        "content": { "type": "string" },
        "from": { "type": "string" },
        "fromMe": { "type": "boolean" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "type": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" }
      }
    },
    "NotificationResponse": {
      "title": "Notification Response",
      "type": "object",
      "description": "Response to a button or poll.",
      "properties": {
        "from": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["button", "poll"] },
        "pollName": { "type": "string" },
        "selectedOptions": { "type": "array", "items": { "type": "string" } },
        "buttonId": { "type": "string" },
        "buttonText": { "type": "string" },
        "receivedAt": { "type": "string", "format": "date-time" }
      }
    },
    "NotificationHistory": {
      "title": "Notification History",
      "type": "object",
      "description": "Log of broadcast messages.",
      "properties": {
        "channel": { "type": "string" },
        "type": { "type": "string" },
        "message": { "type": "string" },
        "recipientCount": { "type": "number" },
        "successCount": { "type": "number" },
        "status": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles."
    },
    "/notifications_chats/{chatId}": {
      "schema": { "$ref": "#/backend/entities/NotificationChat" },
      "description": "Chat summaries."
    },
    "/notifications_messages/{messageId}": {
      "schema": { "$ref": "#/backend/entities/NotificationMessage" },
      "description": "Message history."
    },
    "/notifications_responses/{docId}": {
      "schema": { "$ref": "#/backend/entities/NotificationResponse" },
      "description": "Button and poll responses."
    },
    "/notifications_history/{docId}": {
      "schema": { "$ref": "#/backend/entities/NotificationHistory" },
      "description": "Broadcast history."
    }
  }
}
